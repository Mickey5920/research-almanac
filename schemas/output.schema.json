{
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "run_id",
    "generated_at",
    "status",
    "recommendations",
    "sources",
    "versions",
    "cultural_result"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "mode": {
      "enum": [
        "project",
        "cultural"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ok",
        "conditional",
        "degraded",
        "no_candidates"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "scope"
        ]
      }
    },
    "versions": {
      "type": "object"
    },
    "cultural_result": {
      "type": "object"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "rank",
          "start_utc",
          "end_utc",
          "click_at_utc",
          "local_start",
          "local_end",
          "local_click",
          "practical_reasons",
          "cultural_reasons",
          "direction",
          "sort_factors"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "start_utc": {
            "type": "string",
            "format": "date-time"
          },
          "end_utc": {
            "type": "string",
            "format": "date-time"
          },
          "click_at_utc": {
            "type": "string",
            "format": "date-time"
          },
          "local_start": {
            "type": "string",
            "format": "date-time"
          },
          "local_end": {
            "type": "string",
            "format": "date-time"
          },
          "local_click": {
            "type": "string",
            "format": "date-time"
          },
          "astrology": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "method",
                  "at_utc",
                  "engine",
                  "engine_version",
                  "source_url",
                  "moon",
                  "mercury",
                  "personal",
                  "interpretation",
                  "convention"
                ],
                "properties": {
                  "method": {
                    "const": "tropical-geocentric-v1"
                  },
                  "at_utc": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "engine": {
                    "const": "astronomy-engine"
                  },
                  "engine_version": {
                    "type": "string"
                  },
                  "source_url": {
                    "const": "https://github.com/cosinekitty/astronomy"
                  },
                  "moon": {
                    "type": "object",
                    "required": [
                      "longitude_degrees",
                      "sign",
                      "glyph"
                    ],
                    "properties": {
                      "longitude_degrees": {
                        "type": "number",
                        "minimum": 0,
                        "exclusiveMaximum": 360
                      },
                      "sign": {
                        "enum": [
                          "白羊座",
                          "金牛座",
                          "双子座",
                          "巨蟹座",
                          "狮子座",
                          "处女座",
                          "天秤座",
                          "天蝎座",
                          "射手座",
                          "摩羯座",
                          "水瓶座",
                          "双鱼座"
                        ]
                      },
                      "glyph": {
                        "type": "string"
                      }
                    }
                  },
                  "mercury": {
                    "type": "object",
                    "required": [
                      "longitude_degrees",
                      "speed_degrees_per_day",
                      "motion"
                    ],
                    "properties": {
                      "longitude_degrees": {
                        "type": "number",
                        "minimum": 0,
                        "exclusiveMaximum": 360
                      },
                      "speed_degrees_per_day": {
                        "type": "number"
                      },
                      "motion": {
                        "enum": [
                          "direct",
                          "retrograde",
                          "stationary"
                        ]
                      }
                    }
                  },
                  "personal": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "required": [
                          "sign",
                          "glyph",
                          "basis"
                        ],
                        "properties": {
                          "sign": {
                            "enum": [
                              "白羊座",
                              "金牛座",
                              "双子座",
                              "巨蟹座",
                              "狮子座",
                              "处女座",
                              "天秤座",
                              "天蝎座",
                              "射手座",
                              "摩羯座",
                              "水瓶座",
                              "双鱼座"
                            ]
                          },
                          "glyph": {
                            "type": "string"
                          },
                          "basis": {
                            "const": "user_supplied"
                          }
                        }
                      }
                    ]
                  },
                  "interpretation": {
                    "type": "object",
                    "required": [
                      "kind",
                      "moon",
                      "mercury",
                      "personal"
                    ],
                    "properties": {
                      "kind": {
                        "const": "cultural_reflection"
                      },
                      "moon": {
                        "type": "string"
                      },
                      "mercury": {
                        "type": "string"
                      },
                      "personal": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  },
                  "convention": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
