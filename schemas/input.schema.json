{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "mode": {
      "enum": [
        "project",
        "cultural"
      ]
    },
    "now": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "stage": {
          "enum": [
            "initial",
            "revision",
            "resubmission",
            "unknown"
          ]
        },
        "project_ref": {
          "type": "string"
        },
        "manuscript_version": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "maxLength": 300
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title",
        "stage"
      ]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ready",
            "conditional",
            "unknown",
            "blocked"
          ]
        },
        "ready_after": {
          "type": "string",
          "format": "date-time"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status"
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "next_week",
            "rolling_7_days",
            "custom"
          ]
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date_exclusive": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "mode"
      ]
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "none",
            "unknown",
            "user_supplied",
            "verified"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ]
    },
    "availability": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "start",
          "end"
        ]
      }
    },
    "excluded_intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "start",
          "end"
        ]
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "operation_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 240
        },
        "click_offset_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 239
        },
        "buffer_hours": {
          "type": "number",
          "minimum": 0,
          "maximum": 720
        },
        "buffer_mode": {
          "enum": [
            "soft",
            "hard"
          ]
        },
        "strict_traditional": {
          "type": "boolean"
        },
        "language": {
          "enum": [
            "zh",
            "en"
          ]
        },
        "depth": {
          "enum": [
            "brief",
            "detailed"
          ]
        },
        "preferred_hours": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          }
        }
      },
      "required": []
    },
    "tradition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ruleset": {
          "const": "local-cultural-v1"
        }
      },
      "required": []
    },
    "cultural": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "interpret_text",
            "cast",
            "continue_reading"
          ]
        },
        "excerpt_id": {
          "type": "string"
        },
        "reading": {
          "type": "object"
        },
        "lines": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "enum": [
              6,
              7,
              8,
              9
            ]
          }
        }
      },
      "required": []
    },
    "academic_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "journal_system": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "summary"
          ],
          "properties": {
            "status": {
              "enum": [
                "verified",
                "user_supplied",
                "not_found",
                "unknown"
              ]
            },
            "summary": {
              "type": "string",
              "maxLength": 3000
            },
            "source_title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "source_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "checked_at": {
              "type": "string",
              "format": "date"
            },
            "timezone": {
              "type": "string",
              "maxLength": 80
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "verified"
                  }
                }
              },
              "then": {
                "required": [
                  "source_title",
                  "source_url",
                  "checked_at"
                ]
              }
            }
          ]
        },
        "editorial_office": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "summary"
          ],
          "properties": {
            "status": {
              "enum": [
                "verified",
                "user_supplied",
                "not_found",
                "unknown"
              ]
            },
            "summary": {
              "type": "string",
              "maxLength": 3000
            },
            "source_title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "source_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "checked_at": {
              "type": "string",
              "format": "date"
            },
            "timezone": {
              "type": "string",
              "maxLength": 80
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "verified"
                  }
                }
              },
              "then": {
                "required": [
                  "source_title",
                  "source_url",
                  "checked_at"
                ]
              }
            }
          ]
        },
        "conference_deadline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "summary"
          ],
          "properties": {
            "status": {
              "enum": [
                "verified",
                "user_supplied",
                "not_found",
                "unknown"
              ]
            },
            "summary": {
              "type": "string",
              "maxLength": 3000
            },
            "source_title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "source_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "checked_at": {
              "type": "string",
              "format": "date"
            },
            "timezone": {
              "type": "string",
              "maxLength": 80
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "verified"
                  }
                }
              },
              "then": {
                "required": [
                  "source_title",
                  "source_url",
                  "checked_at"
                ]
              }
            }
          ]
        }
      }
    },
    "astrology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "personal_sign": {
          "enum": [
            "白羊座",
            "金牛座",
            "双子座",
            "巨蟹座",
            "狮子座",
            "处女座",
            "天秤座",
            "天蝎座",
            "射手座",
            "摩羯座",
            "水瓶座",
            "双鱼座"
          ]
        }
      }
    }
  },
  "required": [
    "mode"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "project"
          }
        }
      },
      "then": {
        "required": [
          "timezone",
          "project",
          "readiness"
        ]
      }
    }
  ]
}
