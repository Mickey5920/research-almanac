{
  "name": "zhouyi-paper-submit-advisor",
  "version": "0.10.0",
  "private": true,
  "description": "Weekly research almanac and project planning with optional Zhouyi submission support",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/server.js",
    "test": "node --test tests/*.test.js",
    "demo": "node scripts/cli.js weekly examples/weekly-project.json --out runs/demo",
    "check": "node scripts/check-package.js",
    "pack:release": "node scripts/pack-release.js",
    "demo:submission": "node scripts/cli.js recommend examples/project.json --out runs/submission-demo"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astronomy-engine": "2.1.19",
    "lunar-javascript": "1.7.7",
    "luxon": "3.7.2"
  }
}
